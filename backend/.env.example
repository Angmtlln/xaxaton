# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractors

# --- Master Agent ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MASTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_PROVIDER_SORT=throughput
# Необязательный soft preference, в секундах (не включён по результатам benchmark).
# OPENROUTER_PREFERRED_MAX_LATENCY=3
# Только eval/debug; добавляет verifier и максимум один repair с перепроверкой.
AGENT_GROUNDING_DEBUG=false
# Необязательная атрибуция вызовов в статистике аккаунта OpenRouter.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Counterparty Agent
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_VERIFIER_REASONING_EFFORT=low
# Конечные output-лимиты; reasoning tokens тоже входят в этот бюджет.
AGENT_ROUTER_MAX_TOKENS=512
AGENT_ANSWER_MAX_TOKENS=4096
AGENT_VERIFIER_MAX_TOKENS=4096
AGENT_REPAIR_MAX_TOKENS=4096
AGENT_MODEL_TIMEOUT_S=90
AGENT_VERIFIER_TIMEOUT_S=75
AGENT_RUN_TIMEOUT_S=300
# OpenRouter web plugin автоматически включается только на full-check synthesis.
# Использует OPENROUTER_API_KEY; отдельный ключ поиска не нужен.
WEB_NEWS_DAYS=90
# Только HTTP-проверка даты выбранных публикаций, до 4 параллельно.
WEB_NEWS_TIMEOUT_S=6

# --- Domain agents / Groq (https://console.groq.com) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BLOCK_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Лимит токенов в минуту на бесплатном тарифе считается по каждой модели
# отдельно, поэтому четыре блока разведены по разным моделям.
# gpt-oss-20b оставлен Master-агенту, блоки разведены по другим моделям.
GROQ_BLOCK_MODEL_MAP=identity=qwen/qwen3.8-27b,reliability=openai/gpt-oss-120b,finance=qwen/qwen3.8-27b,experience=qwen/qwen3.6-27b
# Короткие рассуждения у gpt-oss: ответ в 4 раза короче и не обрывается
GROQ_REASONING_EFFORT=low
# Куда уходить, если модель упёрлась в лимит токенов в минуту
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
LLM_MOCK=false

# --- прочее ---
CALCULATOR_VERSION=facts-1.0.0
