# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractors

# --- Groq (https://console.groq.com) ---
# Без ключа сервис работает в детерминированном режиме: LLM_MOCK=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BLOCK_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Master Agent: LangChain create_agent + native tool calling
GROQ_MASTER_MODEL=openai/gpt-oss-20b
# Лимит токенов в минуту на бесплатном тарифе считается по каждой модели
# отдельно, поэтому четыре блока разведены по разным моделям.
GROQ_BLOCK_MODEL_MAP=identity=openai/gpt-oss-20b,reliability=openai/gpt-oss-120b,finance=qwen/qwen3.8-27b,experience=openai/gpt-oss-20b
# Короткие рассуждения у gpt-oss: ответ в 4 раза короче и не обрывается
GROQ_REASONING_EFFORT=low
# Куда уходить, если модель упёрлась в лимит токенов в минуту
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
LLM_MOCK=false

# --- прочее ---
CALCULATOR_VERSION=facts-1.0.0
